# Never ship secrets or local state into the image.
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
*.log
.DS_Store
.git/

# Node / build artifacts (the SPA is rebuilt in the web stage).
web/node_modules/
web/dist/

# Local runtime state — the server regenerates these on the volume at runtime.
data/radar.db
data/.enc_key
data/.oauth_login_state
data/*.pid
data/*.lock
data/scanner.out
data/universe_*.csv
# NOTE: data/nifty500.csv IS shipped (company-name search reference).

# Dev-only material (keeps the image slim).
output/
tests/
docs/
*.md
dashboard_preview.png
