# Rockstar Radar — PRODUCTION config for OCI.
# IMPORTANT: this file holds NO secret values — only your domain, non-secret settings, and
# POINTERS (OCIDs) to secrets stored in OCI Vault. Safe to keep on the VM. Copy to deploy/oci/.env.

# --- Domain (point its DNS A records at the VM's public IP first). Caddy also serves www.<domain> ---
DOMAIN=intraday.live

# --- Postgres (non-secret). The PASSWORD comes from Vault (SECRET_OCID_POSTGRES_PASSWORD below) ---
POSTGRES_USER=radar
POSTGRES_DB=radar

# --- OCI Vault ---
# Region of your Vault (optional; the instance principal usually infers it). e.g. ap-mumbai-1
OCI_REGION=

# Paste the OCID of each secret you created in OCI Vault (these are identifiers, NOT secrets).
# secrets-init reads each and injects it as the matching env var (name after SECRET_OCID_).
SECRET_OCID_SESSION_SECRET=
SECRET_OCID_ENCRYPTION_KEY=
SECRET_OCID_GOOGLE_CLIENT_ID=
SECRET_OCID_GOOGLE_CLIENT_SECRET=
SECRET_OCID_POSTGRES_PASSWORD=
# Optional (support → your Telegram):
# SECRET_OCID_SUPPORT_TELEGRAM_BOT_TOKEN=
# SECRET_OCID_SUPPORT_TELEGRAM_CHAT_ID=

# --- Non-secret build/runtime options ---
RADAR_SCHED=1
# PostHog analytics (public ingest key, build-time; not a secret). Blank = analytics off.
VITE_POSTHOG_KEY=
