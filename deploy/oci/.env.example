# Rockstar Radar — PRODUCTION config for OCI.
# Holds NO secret values — only your domain, non-secret settings, and pointers to the OCI Vault.
# Secret VALUES live in the Vault and are fetched into RAM at boot. Copy to deploy/oci/.env.

# --- Domain (point its DNS A records at the VM's public IP first). Caddy also serves www.<domain> ---
DOMAIN=intraday.live

# --- Postgres (non-secret). Password comes from the Vault secret named POSTGRES_PASSWORD ---
POSTGRES_USER=radar
POSTGRES_DB=radar

# --- OCI Vault (secrets-init lists ALL secrets in this Vault and injects each by name) ---
OCI_REGION=ap-mumbai-1
SECRETS_COMPARTMENT_OCID=
SECRETS_VAULT_OCID=
# Secrets to put in the Vault (by name): SESSION_SECRET, ENCRYPTION_KEY, POSTGRES_PASSWORD,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and optionally SUPPORT_TELEGRAM_BOT_TOKEN / _CHAT_ID.
# Add more anytime — a reboot picks them up (no change here).

# --- Non-secret build/runtime options ---
RADAR_SCHED=1
# PostHog analytics (public ingest key, build-time; not a secret). Blank = analytics off.
VITE_POSTHOG_KEY=
