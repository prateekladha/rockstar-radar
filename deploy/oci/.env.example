# Rockstar Radar — PRODUCTION env for the OCI Docker stack.
# Copy to deploy/oci/.env on the VM (chmod 600). Never commit the real .env.
# Docker Compose auto-loads this file for ${...} interpolation AND injects it into the app container.

# --- Public host: your VM's public IP in DASHED form + .sslip.io (no scheme) ---
# e.g. VM IP 129.153.1.2  ->  129-153-1-2.sslip.io
PUBLIC_HOST=

# --- Postgres (runs as a container on the same VM; pick a strong password) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar

# --- App secrets ---
# openssl rand -hex 32
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Google OAuth (authorized redirect: https://radar.<PUBLIC_HOST>/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Contact/Support -> owner's Telegram (optional) ---
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=

# --- Optional ---
RADAR_SCHED=1
# PostHog (public ingest key; events are proxied via /ingest). Blank = analytics off.
VITE_POSTHOG_KEY=
