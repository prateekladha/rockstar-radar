# Auto-HTTPS reverse proxy for the real domain. {$DOMAIN} comes from the compose env (e.g. intraday.live).
# Requires the domain's DNS A record(s) to point at this VM's public IP, and ports 80/443 open.

{$DOMAIN} {
	encode gzip

	# PostHog reverse proxy (first-party analytics at /ingest — dodges ad-blockers, no 3rd-party host).
	handle_path /ingest/static/* {
		reverse_proxy https://us-assets.i.posthog.com {
			header_up Host us-assets.i.posthog.com
		}
	}
	handle_path /ingest/* {
		reverse_proxy https://us.i.posthog.com {
			header_up Host us.i.posthog.com
		}
	}

	# Everything else -> the app.
	reverse_proxy radar:8080
}

# www -> apex redirect.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri}
}
