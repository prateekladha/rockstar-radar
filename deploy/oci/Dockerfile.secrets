# Minimal one-shot image for secrets-init: reads OCI Vault via instance principal into tmpfs.
# Kept separate from the app image because the OCI SDK conflicts with fyers-apiv3's aiohttp pin.
FROM python:3.11-slim
RUN pip install --no-cache-dir "oci>=2.100,<3"
WORKDIR /app
COPY deploy/oci/secrets_init.py ./secrets_init.py
CMD ["python", "secrets_init.py"]
