# Rockstar Radar — example environment. Copy to `.env` (git-ignored) and fill in.
# NEVER commit a real .env or paste secrets into chat.

# --- Core (local dev) ---
# SQLite is the default; no DATABASE_URL needed locally. For Postgres (prod) use e.g.:
# DATABASE_URL=postgresql+psycopg://radar:password@localhost:5432/radar
SESSION_SECRET=change-me-to-a-long-random-string
# Fernet key for encrypting broker secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key file is auto-created at data/.enc_key (fine for local dev).
ENCRYPTION_KEY=

# Local test login (no Google needed). Set to 1 only in development.
DEV_LOGIN=1

# --- Google OAuth (production sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public origin (production, behind a reverse proxy) ---
# Used to build the broker OAuth callback URL. e.g. https://radar.<dashed-ip>.sslip.io
PUBLIC_BASE_URL=

# --- Optional ---
RADAR_SCHED=1          # market-open scheduler (0 to disable)
# VITE_POSTHOG_KEY=    # PostHog analytics (build-time, public ingest key; blank = analytics off)
